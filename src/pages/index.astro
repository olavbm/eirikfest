---
const p = {
  bg: "#fbf4e4",
  bgAlt: "#f3e9cf",
  paper: "#fffdf6",
  ink: "#2b2520",
  inkSoft: "#6b5e4f",
  sky: "#a4c8d8",
  butter: "#e8c46a",
  poppy: "#d96846",
  sage: "#9bae84",
  rose: "#e89aa3",
};

const facts = [
  { label: "favorittlyd", value: "a-bu", color: p.butter, rotate: -2 },
  { label: "favorittmat", value: "appelsin", color: p.rose, rotate: 1 },
  { label: "spesialitet", value: "latter", color: p.sky, rotate: -1 },
  { label: "drømmer om", value: "trær og hunder", color: p.sage, rotate: 2 },
  { label: "verste fiende", value: "stolbein", color: p.poppy, rotate: -2 },
  { label: "superkraft", value: "smelte hjerter", color: p.butter, rotate: 1 },
];

const plans = [
  {
    label: "lørdag",
    title: "selve dagen",
    body: "15. august kl 14 — seremoni, middag og kake på hytta",
    color: p.poppy,
    rotate: -1.5,
  },
  {
    label: "overnatting",
    title: "bli hele helga",
    body: "én storhytte, alle under samme tak — god plass, kom fredag og dra søndag",
    color: p.sky,
    rotate: 1,
  },
  {
    label: "fritid",
    title: "finn på noe",
    body: "tid sammen med familien, fjelltur, lek ute, kanskje en sauna",
    color: p.sage,
    rotate: -1,
  },
];

const practical = [
  {
    label: "soving",
    title: "sengetøy må du ta med",
    body: "sengesett, laken og håndkle følger ikke med hytta — ta med eget. glemmer du det, ordner vi leie på stedet",
    color: p.sky,
    rotate: -1,
  },
  {
    label: "mat",
    title: "maten er ordnet",
    body: "all mat gjennom helga er tatt hånd om — du trenger ikke tenke på det",
    color: p.poppy,
    rotate: -1.5,
  },
  {
    label: "soving",
    title: "rommene er fordelt",
    body: "vi har satt opp hvem som sover hvor på forhånd — du får beskjed når du kommer",
    color: p.rose,
    rotate: -1.5,
  },
  {
    label: "overnatting",
    title: "hytta er ordnet",
    body: "overnatting og vask er tatt hånd om — du trenger bare å komme",
    color: p.sage,
    rotate: 1.5,
  },
  {
    label: "gaver",
    title: "du trenger ikke ta med noe",
    body: "at du bruker en helg av tiden din på å være med oss er gave nok. vil du absolutt gi noe likevel, har vi en ønskeliste lenger ned",
    color: p.sky,
    rotate: 1,
  },
  {
    label: "hunder",
    title: "bikkja er velkommen",
    body: "hunder er lov på setra — ta den gjerne med på fjelltur",
    color: p.butter,
    rotate: -1,
  },
];

// `id` is the localStorage key for the checkbox — keep it stable even if the
// wording of `item` changes, or people lose their ticked-off list.
const packing = [
  { id: "sengetoy", item: "sengesett og laken", note: "må tas med — glemmer du det, ordner vi leie på stedet", color: p.poppy, rotate: -1.5 },
  { id: "handkle", item: "håndkle", note: "følger heller ikke med — ta med eget", color: p.butter, rotate: 1 },
  { id: "skift", item: "et skift eller to", note: "det er to netter — du trenger ikke mer enn det", color: p.sky, rotate: -1 },
  { id: "finstas", item: "pyntet til festen?", note: "kleskoden er «pent, komfortabelt» — ta på noe du føler deg fin i og orker å ha på hele dagen", color: p.rose, rotate: 1.5 },
  { id: "innesko", item: "innesko", note: "tøfler eller ullsokker, gulvene er kalde om morgenen", color: p.sage, rotate: -1 },
  { id: "fjellsko", item: "fjellsko", note: "vi går på tur hvis været tillater det", color: p.butter, rotate: 1 },
  { id: "regntoy", item: "regntøy og ullag", note: "høyfjellet i august — det kan bli surt og vått", color: p.poppy, rotate: -1.5 },
  { id: "badetoy", item: "badetøy", note: "til saunaen", color: p.sky, rotate: 1 },
];

const directionsUrl = "https://www.google.com/maps/dir/?api=1&destination=" +
  encodeURIComponent("Romundgardseter Hytter, Høvringen, 2672 Sel");

const heroSunRays = (() => {
  const c = 46, r = 92 * 0.28;
  return Array.from({ length: 12 }, (_, i) => {
    const a = (Math.PI * 2 * i) / 12;
    return {
      x1: c + Math.cos(a) * (r + 6), y1: c + Math.sin(a) * (r + 6),
      x2: c + Math.cos(a) * (r + 14), y2: c + Math.sin(a) * (r + 14),
    };
  });
})();

const flowerPetals = Array.from({ length: 6 }, (_, i) => {
  const a = (Math.PI * 2 * i) / 6;
  const c = 35;
  return { cx: c + Math.cos(a) * 70 * 0.28, cy: c + Math.sin(a) * 70 * 0.28 };
});

const starPoints = (size: number) => {
  const c = size / 2;
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const a = (Math.PI * 2 * i) / 10 - Math.PI / 2;
    const r = i % 2 === 0 ? size * 0.46 : size * 0.2;
    pts.push(`${c + Math.cos(a) * r},${c + Math.sin(a) * r}`);
  }
  return pts.join(" ");
};

const wobblePath = (w: number, h: number) =>
  `M 4 ${h - 4} Q ${w * 0.2} 2, ${w * 0.4} ${h - 5} T ${w * 0.8} ${h - 4} T ${w - 4} ${h - 5}`;
---

<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Navnefest til Eirik · 14–16. august 2026</title>
    <meta name="description" content="Navnefest for Eirik på Romundgardseter Hytter, Høvringen, 14.–16. august 2026." />
    <meta name="theme-color" content={p.bg} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Fraunces:ital,wght@1,400;1,600&family=Quicksand:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style define:vars={p}>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: 'Quicksand', system-ui, sans-serif;
        background: var(--bg);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      ::selection { background: var(--poppy); color: var(--paper); }

      .section { position: relative; overflow: hidden; }
      .container { max-width: 1100px; margin: 0 auto; }

      /* Hero */
      .hero {
        min-height: 100vh;
        min-height: 100svh;
        padding: 48px 6vw 80px;
        display: flex;
        flex-direction: column;
      }
      .hero-dots {
        position: absolute; inset: 0;
        background-image: radial-gradient(color-mix(in srgb, var(--inkSoft) 13%, transparent) 1.5px, transparent 1.5px);
        background-size: 32px 32px;
        opacity: 0.6;
        pointer-events: none;
      }
      .hero-top { display: flex; justify-content: center; position: relative; z-index: 2; }
      .hero-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        gap: 24px;
        position: relative;
        z-index: 2;
        padding: 60px 0;
      }
      /* Anchors the hat, and the top margin keeps its pompom clear of the squiggle. */
      .hero-photo-block { position: relative; display: inline-block; margin-top: 44px; }
      .hero-photo-block .float-hat {
        top: -72px; left: 50%;
        transform: translateX(calc(-50% - 14px)) rotate(-10deg);
        transform-origin: bottom center;
      }
      .hero-photo {
        display: block;
        flex: none;
        width: clamp(210px, 28vw, 330px);
        height: auto;
        aspect-ratio: 1;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--ink);
        outline: 8px solid var(--paper);
        background: var(--paper);
        box-shadow: 0 10px 24px color-mix(in srgb, var(--ink) 18%, transparent);
        transform: rotate(-3deg);
      }
      .hero-name-block { position: relative; display: inline-block; }
      .hero-eyebrow {
        font-weight: 500;
        font-size: clamp(18px, 1.8vw, 22px);
        color: var(--inkSoft);
        margin-bottom: 20px;
      }
      .name-wobble {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 0.04em;
        font-family: 'Caveat', 'Comic Sans MS', cursive;
        font-weight: 700;
        font-size: clamp(120px, 22vw, 320px);
        line-height: 0.85;
        -webkit-text-stroke: 2px var(--ink);
      }
      .name-wobble span {
        display: inline-block;
        transform-origin: center bottom;
      }
      .hero-tagline {
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-size: clamp(20px, 2.2vw, 30px);
        color: var(--ink);
        max-width: 640px;
        line-height: 1.4;
        margin-top: 12px;
      }
      .sticker-row {
        display: flex; gap: 14px; flex-wrap: wrap;
        justify-content: center; margin-top: 16px;
      }

      /* Sticker pill */
      .sticker {
        background: var(--sticker-bg);
        border: 1.5px solid var(--ink);
        border-radius: 999px;
        padding: 8px 16px;
        font-family: 'Quicksand', system-ui, sans-serif;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.02em;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        box-shadow: 2px 2px 0 var(--ink);
      }

      /* Hero floating decorations */
      .float { position: absolute; }

      /* About */
      .about {
        background: var(--bgAlt);
        padding: 100px 6vw;
      }
      .header-center { text-align: center; }
      .eyebrow {
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--inkSoft);
        margin-bottom: 12px;
      }
      .h2 {
        margin: 0;
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 600;
        font-style: italic;
        font-size: clamp(40px, 5.5vw, 72px);
        line-height: 1;
        color: var(--ink);
      }
      .wobble-row { display: flex; justify-content: center; margin-top: 14px; }
      .about-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        max-width: 900px;
        margin: 56px auto 0;
      }
      .fact-card {
        border: 1.5px solid var(--ink);
        border-radius: 18px;
        padding: 20px 22px;
        box-shadow: 3px 3px 0 var(--ink);
        min-height: 110px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .fact-label {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
        opacity: 0.7;
        margin-bottom: 4px;
      }
      .fact-value {
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-size: 22px;
        color: var(--ink);
        line-height: 1.15;
      }

      /* WhereWhen */
      .ww { padding: 120px 6vw; background: var(--bg); }
      .ww-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        position: relative;
        z-index: 1;
      }
      @media (max-width: 800px) {
        .ww-grid { grid-template-columns: 1fr; }
      }
      .card {
        border: 1.5px solid var(--ink);
        border-radius: 24px;
        padding: 40px 36px;
        box-shadow: 4px 4px 0 var(--ink);
        position: relative;
      }
      .card-eyebrow {
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        opacity: 0.7;
      }
      .card-headline {
        margin-top: 12px;
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-weight: 600;
        line-height: 1;
        color: var(--ink);
      }
      .card-headline.lg { font-size: clamp(40px, 5vw, 64px); }
      .card-headline.md { font-size: clamp(36px, 4.5vw, 56px); }
      .card-body {
        margin-top: 18px;
        font-weight: 500;
        font-size: 17px;
        color: var(--ink);
        opacity: 0.8;
        line-height: 1.5;
      }

      /* Map */
      .card-actions { margin-top: 24px; }
      .directions-link {
        background: var(--paper);
        border: 1.5px solid var(--ink);
        border-radius: 999px;
        padding: 12px 22px;
        font-family: 'Quicksand', system-ui, sans-serif;
        font-weight: 600;
        font-size: 14px;
        color: var(--ink);
        text-decoration: none;
        box-shadow: 3px 3px 0 var(--ink);
        transform: rotate(-1deg);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: transform 120ms ease, box-shadow 120ms ease;
      }
      .directions-link:hover {
        transform: rotate(-1deg) translate(-1px, -1px);
        box-shadow: 4px 4px 0 var(--ink);
      }

      /* Plans */
      .plans { padding: 120px 6vw; background: var(--bg); }
      .plans-lead {
        max-width: 640px;
        margin: 24px auto 0;
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-size: clamp(18px, 1.8vw, 22px);
        line-height: 1.5;
        color: var(--ink);
        text-align: center;
        opacity: 0.85;
      }
      .plans-grid {
        margin-top: 56px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
      }
      .plan-card {
        border: 1.5px solid var(--ink);
        border-radius: 20px;
        padding: 26px 24px;
        box-shadow: 3px 3px 0 var(--ink);
      }
      .plan-label {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        opacity: 0.7;
      }
      .plan-title {
        margin-top: 8px;
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-weight: 600;
        font-size: 28px;
        color: var(--ink);
        line-height: 1.1;
      }
      .plan-body {
        margin-top: 12px;
        font-weight: 500;
        font-size: 16px;
        color: var(--ink);
        opacity: 0.85;
        line-height: 1.5;
      }

      /* Practical */
      .practical { padding: 120px 6vw; background: var(--bgAlt); }

      /* Packing */
      .packing { padding: 120px 6vw; background: var(--bg); }
      .pack-progress {
        margin-top: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
      }
      .pack-count {
        font-family: 'Caveat', cursive;
        font-weight: 700;
        font-size: 28px;
        line-height: 1;
        color: var(--ink);
      }
      .pack-reset {
        background: var(--paper);
        border: 1.5px solid var(--ink);
        border-radius: 999px;
        padding: 8px 18px;
        font-family: 'Quicksand', system-ui, sans-serif;
        font-weight: 600;
        font-size: 13px;
        color: var(--ink);
        box-shadow: 2px 2px 0 var(--ink);
        transform: rotate(-1deg);
        cursor: pointer;
        transition: transform 120ms ease, box-shadow 120ms ease;
      }
      .pack-reset:hover {
        transform: rotate(-1deg) translate(-1px, -1px);
        box-shadow: 3px 3px 0 var(--ink);
      }
      .pack-grid {
        margin-top: 24px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }
      .pack-card {
        border: 1.5px solid var(--ink);
        border-radius: 16px;
        padding: 18px 20px;
        box-shadow: 2px 2px 0 var(--ink);
        display: flex;
        align-items: flex-start;
        gap: 12px;
        cursor: pointer;
        -webkit-user-select: none;
        user-select: none;
        transition: opacity 120ms ease, box-shadow 120ms ease;
      }
      /* whole card dims once its box is ticked */
      .pack-card:has(.pack-check:checked) {
        opacity: 0.5;
        box-shadow: 1px 1px 0 var(--ink);
      }
      .pack-card:has(.pack-check:focus-visible) {
        outline: 2.5px solid var(--ink);
        outline-offset: 3px;
      }
      .pack-check {
        appearance: none;
        -webkit-appearance: none;
        flex: none;
        margin: 2px 0 0;
        width: 22px;
        height: 22px;
        border: 1.5px solid var(--ink);
        border-radius: 6px;
        background: var(--paper);
        position: relative;
        cursor: pointer;
      }
      .pack-check:checked::after {
        content: "";
        position: absolute;
        left: 6px;
        top: 1px;
        width: 6px;
        height: 12px;
        border: solid var(--ink);
        border-width: 0 2.5px 2.5px 0;
        transform: rotate(42deg);
      }
      .pack-item {
        display: block;
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-weight: 600;
        font-size: 21px;
        line-height: 1.15;
        color: var(--ink);
      }
      .pack-check:checked ~ .pack-text .pack-item {
        text-decoration: line-through;
        text-decoration-thickness: 2px;
      }
      .pack-note {
        display: block;
        margin-top: 6px;
        font-weight: 500;
        font-size: 14px;
        color: var(--ink);
        opacity: 0.75;
        line-height: 1.45;
      }


      /* Footer */
      .footer {
        background: var(--ink);
        color: var(--paper);
        padding: 100px 6vw 60px;
      }
      .footer-inner {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
        position: relative;
        z-index: 2;
      }
      .footer-headline {
        font-family: 'Caveat', cursive;
        font-weight: 700;
        font-size: clamp(48px, 6vw, 84px);
        color: var(--paper);
        line-height: 1;
      }
      .footer-tagline {
        margin-top: 32px;
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-size: 22px;
        color: rgba(255, 253, 246, 0.85);
      }
      .footer-meta {
        margin-top: 40px;
        font-weight: 500;
        font-size: 14px;
        color: rgba(255, 253, 246, 0.55);
        letter-spacing: 0.08em;
      }
      .footer-meta a {
        color: rgba(255, 253, 246, 0.8);
        text-decoration: underline;
        text-underline-offset: 3px;
        /* comfortable thumb target without breaking the inline line */
        display: inline-block;
        padding: 6px 0;
      }

      svg { display: block; }

      /* ───────── Mobile ───────── */
      @media (max-width: 640px) {
        /* Decorations that land on top of the name and tagline */
        .float-cloud-sm, .float-star-a { display: none; }
        .float-hat svg { width: 58px; height: 74px; }
        .hero-photo-block .float-hat { top: -56px; }
        .float-fox svg { width: 84px; height: 59px; }
        .float-flower svg { width: 54px; height: 54px; }

        .hero { padding: 28px 6vw 56px; }
        .hero-main { padding: 28px 0; gap: 18px; }
        .hero-photo { outline-width: 6px; }
        .hero-eyebrow { margin-bottom: 14px; }
        .hero-tagline { font-size: 18px; margin-top: 8px; }
        .sticker-row { gap: 10px; margin-top: 8px; }

        .about { padding: 64px 6vw; }
        .ww, .plans, .practical, .packing { padding: 64px 6vw; }
        .footer { padding: 64px 6vw 48px; }

        /* Long words like "Romundgardseter" were forcing the column wider
           than the screen, clipping the cards' right edge. */
        .ww-grid { grid-template-columns: minmax(0, 1fr); gap: 18px; }
        .card { padding: 26px 22px; border-radius: 20px; }
        /* scales down below ~365px so "Romundgardseter" still fits the card */
        .card-headline.md { font-size: min(30px, 8.2vw); }
        .card-headline.lg { font-size: 38px; }
        .card-body { font-size: 16px; margin-top: 14px; }

        /* Two up — the values are short, one per row wasted a lot of scroll */
        .about-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 12px;
        }
        .about-grid { margin-top: 36px; }
        .fact-card { padding: 16px; min-height: 92px; }
        .fact-label { font-size: 11px; letter-spacing: 0.08em; }
        .fact-value { font-size: 19px; }

        .float-f-heart { top: 18px !important; right: 5vw !important; }
        .float-f-star { bottom: 12px !important; right: 4vw !important; }

        .plans-grid { margin-top: 36px; gap: 16px; }
        .plan-card { padding: 22px 20px; }
        .plans-lead { font-size: 17px; margin-top: 18px; }

        /* Short items — two up saves a lot of scroll on the packing list */
        .pack-grid {
          margin-top: 28px;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 12px;
        }
        .pack-card { padding: 14px; gap: 10px; }
        .pack-item { font-size: 17px; overflow-wrap: break-word; }
        .pack-note { font-size: 13px; }
        .pack-progress { margin-top: 24px; gap: 12px; }
        .pack-count { font-size: 24px; }

        .footer-tagline { font-size: 19px; margin-top: 24px; }
        .footer-meta { margin-top: 28px; }
      }
    </style>
  </head>

  <body>
    <!-- ───────── Hero ───────── -->
    <section class="section hero">
      <div class="hero-dots"></div>

      <!-- Floating decorations -->
      <div class="float" style="top: 8%; left: 6vw;">
        <!-- Sun 92 -->
        <svg width="92" height="92" viewBox="0 0 92 92">
