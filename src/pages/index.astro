    <script is:inline>
      // Packing list ticks live in localStorage — no accounts, no server, and it
      // survives closing the tab so you can pack over several evenings.
      (function () {
        var KEY = "eirikfest.pakkeliste.v1";
        var boxes = [].slice.call(document.querySelectorAll(".pack-check"));
        var count = document.querySelector(".pack-count");
        var reset = document.querySelector(".pack-reset");
        if (!boxes.length || !count || !reset) return;

        function load() {
          try {
            var raw = JSON.parse(localStorage.getItem(KEY));
            return Array.isArray(raw) ? raw : [];
          } catch (e) {
            return [];
          }
        }

        function save() {
          var done = boxes
            .filter(function (b) { return b.checked; })
            .map(function (b) { return b.dataset.pack; });
          try {
            localStorage.setItem(KEY, JSON.stringify(done));
          } catch (e) {
            // private mode / storage full — the ticks still work for this visit
          }
          render();
        }

        function render() {
          var done = boxes.filter(function (b) { return b.checked; }).length;
          count.textContent = done + " av " + boxes.length + " pakket";
        }

        var saved = load();
        boxes.forEach(function (b) {
          b.checked = saved.indexOf(b.dataset.pack) !== -1;
          b.addEventListener("change", save);
        });

        reset.addEventListener("click", function () {
          boxes.forEach(function (b) { b.checked = false; });
          save();
        });

        render();
      })();
    </script>

